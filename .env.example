# ./scripts/dev-up creates .env with random local-only passwords.
# These variables are intentionally blank because credentials do not belong in Git.
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
REDIS_PASSWORD=

# Optional host-port overrides.
POSTGRES_PORT=5432
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PORT=6379
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
JAEGER_UI_PORT=16686
