#!/usr/bin/env bash
set -euo pipefail

readonly image_name="squad-up/lobby-service:local"
readonly container_name="squad-up-lobby-smoke-${RANDOM}"
readonly signing_directory="$(mktemp -d)"
readonly signing_key_path="${signing_directory}/private.pem"
readonly public_key_path="${signing_directory}/public.pem"
openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "${signing_key_path}" 2>/dev/null
openssl pkey -in "${signing_key_path}" -pubout -out "${public_key_path}" 2>/dev/null
readonly public_key="$(<"${public_key_path}")"

cleanup() {
  docker rm --force "${container_name}" >/dev/null 2>&1 || true
  rm -f "${signing_key_path}" "${public_key_path}"
  rmdir "${signing_directory}"
}

trap cleanup EXIT

docker build \
  --file src/Lobby/SquadUp.LobbyService.Api/Dockerfile \
  --tag "${image_name}" \
  .

runtime_user="$(docker image inspect --format '{{.Config.User}}' "${image_name}")"
if [[ -z "${runtime_user}" || "${runtime_user}" == "0" || "${runtime_user}" == "root" ]]; then
  echo "Lobby image must declare a non-root runtime user." >&2
  exit 1
fi

docker run \
  --detach \
  --name "${container_name}" \
  --read-only \
  --tmpfs /tmp:rw,noexec,nosuid,size=16m \
  --publish 127.0.0.1::8080 \
  --security-opt no-new-privileges:true \
  --env "ConnectionStrings__LobbyDatabase=Host=127.0.0.1;Port=1;Database=lobby_smoke;Username=smoke;Timeout=1" \
  --env "InternalAuthentication__PublicKeys__smoke-current=${public_key}" \
  "${image_name}" >/dev/null

published_address="$(docker port "${container_name}" 8080/tcp)"
health_url="http://${published_address}/health/live"

for _ in {1..30}; do
  if curl --fail --silent "${health_url}" >/dev/null; then
    echo "Lobby container is healthy and runs as user ${runtime_user}."
    exit 0
  fi

  sleep 1
done

docker logs "${container_name}" >&2
echo "Lobby container did not become ready at ${health_url}." >&2
exit 1
