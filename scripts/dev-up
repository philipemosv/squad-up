#!/usr/bin/env bash

set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
environment_file="$repository_root/.env"
compose_arguments=(--project-directory "$repository_root")

for profile in "$@"; do
  case "$profile" in
    aws | chaos)
      compose_arguments+=(--profile "$profile")
      ;;
    *)
      printf 'Unknown profile: %s. Expected aws or chaos.\n' "$profile" >&2
      exit 2
      ;;
  esac
done

if [[ ! -f "$environment_file" ]]; then
  umask 077
  postgres_password="$(openssl rand -hex 24)"
  rabbitmq_password="$(openssl rand -hex 24)"
  redis_password="$(openssl rand -hex 24)"

  {
    printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password"
    printf 'RABBITMQ_PASSWORD=%s\n' "$rabbitmq_password"
    printf 'REDIS_PASSWORD=%s\n' "$redis_password"
  } > "$environment_file"

  printf 'Created %s with random local-only credentials.\n' "$environment_file"
fi

docker compose "${compose_arguments[@]}" up --detach --wait

printf '\nLocal platform is ready:\n'
printf '  RabbitMQ management: http://localhost:15672 (user: squadup)\n'
printf '  Jaeger:             http://localhost:16686\n'
printf '  OTel health:        http://localhost:13133\n'
printf '\nPasswords are stored only in %s and container memory.\n' "$environment_file"
