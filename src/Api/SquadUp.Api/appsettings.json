{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "InternalTokens": {
    "Issuer": "https://api.squad-up.internal",
    "LobbyAudience": "squad-up-lobby",
    "ClientId": "squad-up-api",
    "LifetimeSeconds": 120,
    "ActiveKeyId": "",
    "PrivateKeyPem": "",
    "AllowedScopes": [
      "lobby.read",
      "lobby.write"
    ]
  },
  "LobbyClient": {
    "BaseAddress": "https://lobby.squad-up.internal"
  },
  "AllowedHosts": "*"
}
